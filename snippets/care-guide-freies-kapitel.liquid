{% comment %}
  Tungacea — ein frei geschriebenes Kapitel im Pflegeguide (Block "Weiteres
  Kapitel"): Ankunft, Substrat und Umtopfen oder Probleme.

  Überschrift und Einleitung kommen aus dem Block; leer stehen die
  übersetzten Vorgaben. Der Text ist frei, mit Absätzen und Listen. Gibt es
  für das Thema keinen Block mit Text, erscheint nichts. Mehrere Blöcke zum
  selben Thema: es zählt der erste.

  Annahmen:
  - bloecke: {Array} section.blocks (Pflicht)
  - thema: {String} ankunft | substrat | probleme (Pflicht)
{% endcomment %}
{%- liquid
  assign kapitel_block = nil
  for b in bloecke
    if b.type == 'kapitel' and b.settings.thema == thema and b.settings.text != blank
      assign kapitel_block = b
      break
    endif
  endfor
-%}
{%- if kapitel_block -%}
  {%- liquid
    case thema
      when 'ankunft'
        assign vorgabe_titel = 'care_guide.arrival_title' | t
        assign vorgabe_lead = 'care_guide.arrival_lead' | t
      when 'substrat'
        assign vorgabe_titel = 'care_guide.substrate_title' | t
        assign vorgabe_lead = 'care_guide.substrate_lead' | t
      when 'probleme'
        assign vorgabe_titel = 'care_guide.problems_title' | t
        assign vorgabe_lead = 'care_guide.problems_lead' | t
    endcase
    assign k_titel = kapitel_block.settings.titel | default: '' | strip
    if k_titel == blank
      assign k_titel = vorgabe_titel
    endif
    assign k_lead = kapitel_block.settings.einleitung | default: '' | strip
    if k_lead == blank
      assign k_lead = vorgabe_lead
    endif
  -%}
  <section class="care-guide__chapter" id="{{ thema }}" data-testid="care-guide-{{ thema }}" {{ kapitel_block.shopify_attributes }}>
    <h2 class="care-guide__title">{{ k_titel | escape }}</h2>
    <p class="care-guide__chapter-lead">{{ k_lead | escape }}</p>
    <div class="care-guide__text care-guide__text--kapitel rte">{{ kapitel_block.settings.text }}</div>
  </section>
{%- endif -%}
