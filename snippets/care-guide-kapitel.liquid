{% comment %}
  Tungacea — die übrigen Kapitel des Pflegeguides als kleine Tafel.

  Dasselbe System wie die Stadien (snippets/care-guide-tafel.liquid): eine
  feine Strichzeichnung, darunter die rote Linie und der Name. Ein Tipp
  springt zum Kapitel. Bedingungen zeigt eine Lampe über einer Pflanze,
  Nährstoffe eine Tropfflasche, Gießwasser eine Gießkanne. Es erscheinen nur
  Kapitel, die Inhalt haben.

  Annahmen:
  - bedingungen: {Boolean} Kapitel Bedingungen hat Inhalt
  - naehrstoffe: {Boolean} Kapitel Nährstoffe hat Inhalt
  - wasser: {Boolean} Kapitel Gießwasser hat Inhalt
{% endcomment %}
{%- liquid
  assign kapitel = ''
  if bedingungen
    assign kapitel = kapitel | append: 'bedingungen,'
  endif
  if naehrstoffe
    assign kapitel = kapitel | append: 'naehrstoffe,'
  endif
  if wasser
    assign kapitel = kapitel | append: 'wasser,'
  endif
  assign kapitel = kapitel | split: ','
-%}
{%- if kapitel.size > 0 -%}
  <nav class="care-guide__tafel care-guide__tafel--kapitel" aria-label="{{ 'care_guide.nav_label' | t }}" data-testid="care-guide-nav" style="--eintraege: {{ kapitel.size }};">
    <ol class="care-guide__tafel-liste" role="list">
      {%- for k in kapitel -%}
        <li>
          <a class="care-guide__eintrag care-guide__nav-link" href="#{{ k }}">
            <svg class="care-guide__zeichnung" viewBox="0 18 64 62" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              {%- case k -%}
                {%- when 'bedingungen' -%}
                  <path d="M14 70H50"/><path d="M19 73H45" opacity=".45"/><path d="M18 28h28"/><path d="M20 28v2.6h24V28"/><path d="M32 22v6"/><path d="M24 34l-3 7M32 34v8M40 34l3 7" stroke-dasharray="1.6 2.4" opacity=".7"/><path d="M26.4 60h11.2l-1.6 10h-8Z"/><path d="M32 60c0-4 .6-7 2-9.6"/><g class="b" transform="translate(34 50.6) rotate(-40) scale(0.42) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g><path d="M31.6 60c-.8-2.4-2.2-4-4.2-5"/><g class="b" transform="translate(27.4 55) rotate(44) scale(0.3) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g>
                {%- when 'naehrstoffe' -%}
                  <path d="M14 70H50"/><path d="M19 73H45" opacity=".45"/><path class="b" d="M24 44h12v24a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2Z"/><path d="M26 44v-4h8v4"/><path d="M28 40v-3.6h4V40"/><path d="M30 36.4v-4"/><path d="M24 52h12" opacity=".45"/><path d="M42.6 56.4c1.4 2 2.2 3.4 2.2 4.4a2.2 2.2 0 0 1-4.4 0c0-1 .8-2.4 2.2-4.4Z"/><path d="M42.6 66.6v1.6" opacity=".6"/>
                {%- when 'wasser' -%}
                  <path d="M14 70H50"/><path d="M19 73H45" opacity=".45"/><path class="b" d="M18 50h18l-1.6 18h-14.8Z"/><path d="M36 54.6l9-8.4"/><path d="M45 46.2l2.6-1.2-1 2.8"/><path d="M21 50c0-6 3-9 6-9s6 3 6 9"/><path d="M18.6 56h16.6" opacity=".45"/><path d="M49.4 50.2c.8 1.2 1.2 2 1.2 2.6a1.2 1.2 0 0 1-2.4 0c0-.6.4-1.4 1.2-2.6ZM51.4 57.4c.8 1.2 1.2 2 1.2 2.6a1.2 1.2 0 0 1-2.4 0c0-.6.4-1.4 1.2-2.6ZM48.4 63.2c.8 1.2 1.2 2 1.2 2.6a1.2 1.2 0 0 1-2.4 0c0-.6.4-1.4 1.2-2.6Z"/>
              {%- endcase -%}
            </svg>
            <span class="care-guide__eintrag-stufe"></span>
            <span class="care-guide__eintrag-name">
              {%- case k -%}
                {%- when 'bedingungen' -%}{{ 'care_guide.nav_conditions' | t }}
                {%- when 'naehrstoffe' -%}{{ 'care_guide.nav_nutrients' | t }}
                {%- when 'wasser' -%}{{ 'care_guide.nav_water' | t }}
              {%- endcase -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ol>
  </nav>
{%- endif -%}
