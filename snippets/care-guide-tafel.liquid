                {%- when 'saemling' -%}
                  <path d="M14 70H50"/><path d="M19 73H45" opacity=".45"/><path d="M31 70c-1.2800000000000002 2.08-3.2 3.3600000000000003-5.28 3.84M33 70c0.6400000000000001 2.2399999999999998 2.2399999999999998 3.6799999999999997 4.16 4.16"/><path d="M32 70c0-7 .6-12 2.2-16.4"/><g class="b" transform="translate(34.2 53.6) rotate(-38) scale(0.6) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g>
                {%- when 'jungpflanze' -%}
                  <path d="M14 70H50"/><path d="M19 73H45" opacity=".45"/><path d="M31 70c-1.6 2.6-4.0 4.2-6.6 4.8M33 70c0.8 2.8 2.8 4.6 5.2 5.2"/><path d="M32.4 70c.4-9 1.8-16 4.6-22.6"/><path d="M31.6 70c-.6-6.4-2.4-11-5.4-14.6"/><g class="b" transform="translate(26.2 55.4) rotate(44) scale(0.62) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g><g class="b" transform="translate(37 47.4) rotate(-40) scale(0.86) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g>
                {%- when 'etabliert' -%}
