                {%- when 'mutterpflanze' -%}
                  <path d="M10 70H54"/><path d="M15 73H49" opacity=".45"/><path d="M31 70c-2.0 3.25-5.0 5.25-8.25 6.0M33 70c1.0 3.5 3.5 5.75 6.5 6.5"/><path d="M31 70c-2.2-14-4.4-27-9.6-39"/><g class="b" transform="translate(21.4 31) rotate(64) scale(0.4) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g><path class="b" d="M21 30.6l3.4-7.2a1.15 1.15 0 0 1 2.1 1l-3.4 7.2Z"/><path d="M32.2 70c.4-13 2-24 5.4-33"/><path d="M31.6 70c-1.4-9.8-4.4-17-9.4-22"/><path d="M33 70c2.4-8 6-13 11.4-16.6"/><g class="b" transform="translate(44.4 53.4) rotate(-66) scale(0.78) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g><g class="b" transform="translate(22.2 48) rotate(54) scale(0.9) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g><g class="b" transform="translate(37.6 37) rotate(-26) scale(1.14) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g>
                {%- when 'steckling' -%}
                  <path d="M14 70c2.6-2 4.4-2 7 0s4.4 2 7 0 4.4-2 7 0 4.4 2 7 0 4.4-2 7 0"/><path d="M18 73.4c2.6-1.6 4.4-1.6 7 0s4.4 1.6 7 0 4.4-1.6 7 0 4.4 1.6 7 0" opacity=".45"/><path d="M31.6 64.6c.2-7.4 1.6-14 4.6-19.6"/><path d="M31.2 64.8c-1.2-3-3-5-5.4-6.2"/><path d="M25.8 58.6c-1.6-.2-3 .4-3.6 1.6 1.4.8 2.8.6 3.8-.6"/><g class="b" transform="translate(36.2 45) rotate(-52) scale(0.62) translate(-12 -8)"><path d="M12 33C5.5 26.5 1.5 18.5 2.2 11.2 2.7 6 6.6 4.3 9.8 6.4L12 8l2.2-1.6c3.2-2.1 7.1-.4 7.6 4.8.7 7.3-3.3 15.3-9.8 21.8Z"/><path d="M12 8.5v23"/></g><path class="b" d="M22 64.8l20-.8.2 3.6-20 .8Z"/><path d="M31.4 64.4l.2 3.6" opacity=".7"/><path d="M31.6 68c-.4 1.8-1.4 3.2-2.8 4M31.8 68c.8 1.6 2.2 2.6 3.8 3"/>
              {%- endcase -%}
            </svg>
            {%- comment -%} Der Steckling hat keine Stufe; er zweigt von der Mutterpflanze ab. {%- endcomment -%}
            <span class="care-guide__eintrag-stufe">
              {%- unless st == 'steckling' -%}{{ stufe | prepend: '0' | slice: -2, 2 }}{%- endunless -%}
            </span>
            <span class="care-guide__eintrag-name">{%- render 'care-guide-stadium-name', stadium: st -%}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ol>
</div>
