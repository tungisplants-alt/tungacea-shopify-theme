{% comment %}
  Tungacea — Schreib-mir-Knopf.

  Ein ruhiger Knopf unten rechts, der WhatsApp mit einem vorausgefuellten Satz
  oeffnet. Kein Chat-Fenster und kein Skript eines Anbieters: Es ist ein Link
  auf wa.me, und erst mit dem Klick verlaesst man die Seite.

  Die Nummer steht im Theme-Editor unter Theme-Einstellungen, WhatsApp-Kontakt.
  Sie darf mit Plus, Leerzeichen, Strichen oder fuehrender 0 stehen und wird
  zu Ziffern mit Laendervorwahl. Was keine Nummer ergibt, blendet den Knopf aus,
  statt einen Link ins Leere zu setzen.

  Auf Produktseiten steht der Produktname im Satz, sonst ein allgemeiner.
  Der Satz kommt aus den Sprachdateien (whatsapp_contact.*), Deutsch und
  Englisch getrennt.

  Aufruf:
  {%- render 'whatsapp-contact' -%}
{% endcomment %}
{%- liquid
  assign aktiv = true
  if settings.whatsapp_aktiv == false
    assign aktiv = false
  endif

  assign nummer = settings.whatsapp_nummer | default: '' | strip
  assign nummer = nummer | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '/' | remove: '.'
  assign anfang = nummer | slice: 0, 2
  assign erste = nummer | slice: 0, 1
  if anfang == '00'
    assign nummer = nummer | slice: 2, 20
  elsif erste == '0'
    assign rest = nummer | slice: 1, 20
    assign nummer = '49' | append: rest
  endif

  assign pruefung = nummer | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
  if pruefung != blank or nummer.size < 10 or nummer.size > 15
    assign aktiv = false
  endif

  if aktiv
    if template.name == 'product' and product.title != blank
      assign nachricht = 'whatsapp_contact.message_product' | t: name: product.title
    else
      assign nachricht = 'whatsapp_contact.message' | t
    endif
    assign kodiert = nachricht | url_encode | replace: '+', '%20'
    assign adresse = 'https://wa.me/' | append: nummer | append: '?text=' | append: kodiert
  endif
-%}

{%- if aktiv -%}
  {{ 'component-whatsapp-contact.css' | asset_url | stylesheet_tag }}

  <a
    class="whatsapp-contact"
    href="{{ adresse | escape }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ 'whatsapp_contact.aria_label' | t | escape }}"
    aria-describedby="a11y-new-window-message"
    data-whatsapp-contact
  >
    <svg
      class="whatsapp-contact__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H10l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
    </svg>
    <span class="whatsapp-contact__text">{{ 'whatsapp_contact.label' | t }}</span>
  </a>
{%- endif -%}
