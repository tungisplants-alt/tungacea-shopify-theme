{%- comment -%}
  Tungacea — interactive drag-to-rotate 360° plant viewer.

  Replaces ONLY the static hero media inside the password-page
  email-signup-banner. Reuses the existing .banner__media geometry and
  composition (object-fit: cover, object-position: center 30%) so the plant
  is framed identically to the previous static hero.

  Accepts:
    section — the email-signup-banner section (passed from the caller)

  Notes:
  - The <video> is muted, playsinline, has no controls and never autoplays
    in the primary scrub mode. Rotation is driven by mapping horizontal drag
    distance to video.currentTime (see password-360-viewer.js).
  - A poster / first frame guarantees the area is never blank and prevents
    layout shift.
{%- endcomment -%}

{{ 'password-360-viewer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sensitivity = section.settings.drag_sensitivity | default: 1.0
  assign idle_enabled = section.settings.enable_idle_rotation

  if section.settings.video_poster != blank
    assign poster_url = section.settings.video_poster | image_url: width: 1080
  else
    assign poster_url = 'anthurium-360-poster.jpg' | asset_url
  endif
-%}

<div
  class="banner__media media tng-360__stage"
  data-tng-360
  data-sensitivity="{{ sensitivity }}"
  data-idle="{% if idle_enabled %}true{% else %}false{% endif %}"
  tabindex="0"
  role="slider"
  aria-label="{{ 'general.password_page.login_form_heading' | t | default: shop.name | escape }} — drag to rotate the plant"
  aria-valuemin="0"
  aria-valuemax="360"
  aria-valuenow="0"
  data-testid="password-360-viewer"
>
  <video
    class="tng-360__video"
    poster="{{ poster_url }}"
    muted
    playsinline
    preload="auto"
    disablepictureinpicture
    disableremoteplayback
    tabindex="-1"
    draggable="false"
    aria-hidden="true"
    data-testid="password-360-video"
  >
    {%- if section.settings.video != blank -%}
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    {%- else -%}
      <source src="{{ 'anthurium-360.mp4' | asset_url }}" type="video/mp4">
    {%- endif -%}
  </video>
</div>

{%- if section.settings.show_drag_hint -%}
  <div class="tng-360__hint" data-tng-360-hint aria-hidden="true" data-testid="password-360-hint">
    <span class="tng-360__hint-line" aria-hidden="true"></span>
    <span class="tng-360__hint-label">{{ section.settings.drag_hint_text | default: 'Drag to rotate' | escape }}</span>
  </div>
{%- endif -%}

<script src="{{ 'password-360-viewer.js' | asset_url }}" defer="defer"></script>
