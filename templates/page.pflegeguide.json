{
  "sections": {
    "main": {
      "type": "main-care-guide",
      "blocks": {
        "stadium_steckling": {"type": "stadium", "settings": {"stadium": "steckling", "kurz": "Hohe Luftfeuchte, wenig Licht und Geduld, bis die Wurzeln kommen.", "vpd": "0,4–0,6", "ppfd": "50–100", "temperatur": "24–26", "ec": "0,4", "text": "<p>Frische Stecklinge stehen bei mir in einer geschlossenen Box. Ich gieße kaum und warte, bis neue Wurzeln sichtbar sind.</p>"}},
        "stadium_etabliert": {"type": "stadium", "settings": {"stadium": "etabliert", "kurz": "Ruhig weiterwachsen lassen und die Bedingungen nicht mehr groß ändern.", "vpd": "0,8–1,0", "ppfd": "150–250", "temperatur": "22–26", "ec": "0,8", "text": "<p>Etablierte Pflanzen stehen im Growzelt. Ich dünge bei jedem Gießen und lasse das Substrat zwischendurch leicht antrocknen.</p>"}},
        "stadium_jungpflanze": {"type": "stadium", "settings": {"stadium": "jungpflanze", "kurz": "Mehr Licht, regelmäßig düngen, Luftfeuchte langsam senken.", "vpd": "0,6–0,8", "ppfd": "100–200", "temperatur": "22–26", "ec": "0,6", "text": "<p>Jungpflanzen gewöhne ich Schritt für Schritt an trockenere Luft, damit die neuen Blätter fest werden.</p>"}},
        "stadium_saemling": {"type": "stadium", "settings": {"stadium": "saemling", "kurz": "Klein und empfindlich: gleichmäßig feucht halten.", "vpd": "0,4–0,6", "ppfd": "50–120", "temperatur": "24–26", "ec": "0,4", "text": "<p>Sämlinge bleiben bei mir lange in der Box. Erst ab dem dritten, vierten Blatt kommen sie in einen eigenen Topf.</p>"}},
        "stadium_samen": {"type": "stadium", "settings": {"stadium": "samen", "kurz": "Gerade gekeimt: feucht und warm, kaum Dünger.", "vpd": "0,3–0,5", "ppfd": "30–80", "temperatur": "25–27", "ec": "0,2", "text": "<p>Gekeimte Samen liegen auf feuchtem Sphagnum in einer geschlossenen Dose. Gedüngt wird erst, wenn das erste Blatt offen ist.</p>"}},
        "stadium_mutterpflanze": {"type": "stadium", "settings": {"stadium": "mutterpflanze", "kurz": "Stabile Bedingungen und kräftig düngen.", "vpd": "0,8–1,2", "ppfd": "200–300", "temperatur": "22–26", "ec": "1,0", "text": "<p>Mutterpflanzen stehen bei mir am hellsten Platz. Ich verändere hier möglichst wenig, damit sie gleichmäßig austreiben.</p>"}},
        "bedingung_aufstellung": {"type": "bedingung", "settings": {"name": "Aufstellung", "wert": "Growzelt und Vitrine"}},
        "bedingung_substrat": {"type": "bedingung", "settings": {"name": "Substrat", "wert": "Grobe Mischung aus Pinienrinde, Perlite, Bims und etwas Sphagnum"}},
        "bedingung_gefaess": {"type": "bedingung", "settings": {"name": "Gefäß", "wert": "Durchsichtige Töpfe mit vielen Löchern"}},
        "bedingung_lichtquelle": {"type": "bedingung", "settings": {"name": "Lichtquelle", "wert": "LED-Vollspektrum"}},
        "bedingung_lichtdauer": {"type": "bedingung", "settings": {"name": "Lichtdauer", "wert": "12 Stunden am Tag"}},
        "bedingung_luftbewegung": {"type": "bedingung", "settings": {"name": "Luftbewegung", "wert": "Kleiner Ventilator, rund um die Uhr auf niedriger Stufe"}},
        "naehrstoff_1": {"type": "naehrstoff", "settings": {"name": "Mineraldünger, komplett", "art": "basis", "zweck": "Grundversorgung mit allen Haupt- und Spurenelementen", "dosierung": "Bei jedem Gießen, nach EC"}},
        "naehrstoff_2": {"type": "naehrstoff", "settings": {"name": "Calcium und Magnesium", "art": "basis", "zweck": "Gegen Mangel bei weichem Wasser", "dosierung": "0,5 ml pro Liter, bei jedem Gießen"}},
        "naehrstoff_3": {"type": "naehrstoff", "settings": {"name": "Silizium", "art": "zusatz", "zweck": "Festere Blätter und Stiele", "dosierung": "Alle zwei Wochen"}},
        "naehrstoff_4": {"type": "naehrstoff", "settings": {"name": "Huminsäuren", "art": "zusatz", "zweck": "Für kräftige Wurzeln", "dosierung": "Einmal im Monat"}},
        "wasser_steckling": {"type": "wasser", "settings": {"stadium": "steckling", "ph": "5,8", "ec": "0,4"}},
