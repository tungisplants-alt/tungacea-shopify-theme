{{ 'section-private-archive.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'private_archive.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'private_archive.heading' | t
  endif

  assign specimen_blocks = section.blocks | where: 'type', 'specimen'

  assign statuses = ''
  for block in specimen_blocks
    if block.settings.status != blank
      unless statuses contains block.settings.status
        assign statuses = statuses | append: block.settings.status | append: ','
      endunless
    endif
  endfor
  assign status_list = statuses | split: ','
-%}

<div
  class="private-archive color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
  data-testid="private-archive-section"
>
  <div class="page-width">
    <header class="private-archive__intro">
      {%- if eyebrow != blank -%}
        <p class="private-archive__eyebrow caption-with-letter-spacing" data-testid="private-archive-eyebrow">
          {{- eyebrow | escape -}}
        </p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h1 class="private-archive__heading" data-testid="private-archive-heading">{{ heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="private-archive__lead rte">{{ section.settings.intro }}</div>
      {%- else -%}
        <div class="private-archive__lead rte"><p>{{ 'private_archive.intro' | t }}</p></div>
      {%- endif -%}
    </header>

    {%- if section.settings.enable_filters and status_list.size > 1 -%}
      <div
        class="private-archive__filters"
        role="group"
        aria-label="{{ 'private_archive.filters.title' | t }}"
        data-testid="private-archive-filters"
      >
        <button
          type="button"
          class="private-archive__filter is-active"
          data-filter="all"
          aria-pressed="true"
          data-testid="private-archive-filter-all"
        >
          {{- 'private_archive.filters.all' | t -}}
        </button>
        {%- for st in status_list -%}
          {%- assign status_key = 'private_archive.status.' | append: st -%}
          <button
            type="button"
            class="private-archive__filter"
            data-filter="{{ st }}"
            aria-pressed="false"
            data-testid="private-archive-filter-{{ st }}"
          >
            {{- status_key | t -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if specimen_blocks.size > 0 -%}
      <div class="private-archive__grid" id="ArchiveGrid-{{ section.id }}" data-testid="private-archive-grid">
        {%- for block in specimen_blocks -%}
          {%- liquid
            assign status_label = ''
            if block.settings.status != blank
              assign status_key = 'private_archive.status.' | append: block.settings.status
              assign status_label = status_key | t
            endif

            assign link_label = block.settings.link_label
            if link_label == blank
              assign link_label = 'private_archive.view_specimen' | t
            endif

            assign archive_image_alt = block.settings.image.alt
            if archive_image_alt == blank
              assign archive_image_alt = block.settings.name | strip_html | strip
            endif

            assign has_botanical_documentation = false
            if block.settings.primary_trait != blank or block.settings.growth_stage != blank or block.settings.propagation != blank or block.settings.origin != blank or block.settings.rarity != blank or block.settings.care != blank or block.settings.photo_conditions != blank or block.settings.sale_type != blank or block.settings.shipping != blank
              assign has_botanical_documentation = true
            endif
          -%}
          <article
            class="private-archive__item"
            data-status="{{ block.settings.status }}"
            data-testid="private-archive-specimen"
            {{ block.shopify_attributes }}
          >
            <div class="private-archive__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    alt: archive_image_alt,
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    class: 'private-archive__image'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'private-archive__image private-archive__image--placeholder' }}
              {%- endif -%}
              {%- if block.settings.image_secondary != blank -%}
                {{
                  block.settings.image_secondary
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    alt: archive_image_alt,
                    sizes: '(min-width: 990px) 25vw, 45vw',
                    widths: '300, 500, 700, 1000',
                    class: 'private-archive__image private-archive__image--secondary'
                }}
              {%- endif -%}
            </div>

            <div class="private-archive__body">
              {%- if status_label != blank -%}
                <p class="private-archive__status" data-testid="private-archive-status">{{ status_label }}</p>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <h2 class="private-archive__name">{{ block.settings.name | escape }}</h2>
              {%- endif -%}

              <dl class="private-archive__meta">
                {%- if block.settings.plant_id != blank -%}
                  <div class="private-archive__row">
                    <dt>{{ 'private_archive.labels.plant_id' | t }}</dt>
                    <dd>{{ block.settings.plant_id | escape }}</dd>
                  </div>
                {%- endif -%}
                {%- if block.settings.genetics != blank -%}
                  <div class="private-archive__row">
                    <dt>{{ 'private_archive.labels.genetics' | t }}</dt>
                    <dd>{{ block.settings.genetics | escape }}</dd>
                  </div>
                {%- endif -%}
                {%- if block.settings.parentage != blank -%}
                  <div class="private-archive__row">
                    <dt>{{ 'private_archive.labels.parentage' | t }}</dt>
                    <dd>{{ block.settings.parentage | escape }}</dd>
                  </div>
                {%- endif -%}
                {%- if block.settings.breeder != blank -%}
                  <div class="private-archive__row">
                    <dt>{{ 'private_archive.labels.breeder' | t }}</dt>
                    <dd>{{ block.settings.breeder | escape }}</dd>
                  </div>
                {%- endif -%}
                {%- if block.settings.year != blank -%}
                  <div class="private-archive__row">
                    <dt>{{ 'private_archive.labels.year' | t }}</dt>
                    <dd>{{ block.settings.year | escape }}</dd>
                  </div>
                {%- endif -%}
              </dl>

              {%- if has_botanical_documentation -%}
                <details class="private-archive__documentation">
                  <summary class="private-archive__documentation-summary">
                    <span>{{ 'private_archive.documentation_heading' | t }}</span>
                    <span class="private-archive__documentation-icon" aria-hidden="true"></span>
                  </summary>
                  <div class="private-archive__documentation-body">
                    <dl class="private-archive__meta private-archive__meta--documentation">
                      {%- if block.settings.primary_trait != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.primary_trait' | t }}</dt>
                          <dd>{{ block.settings.primary_trait | escape }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.growth_stage != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.growth_stage' | t }}</dt>
                          <dd>{{ block.settings.growth_stage | escape }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.propagation != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.propagation' | t }}</dt>
                          <dd>{{ block.settings.propagation | escape }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.origin != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.origin' | t }}</dt>
                          <dd>{{ block.settings.origin | escape }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.rarity != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.rarity' | t }}</dt>
                          <dd>{{ block.settings.rarity | escape }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.care != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.care' | t }}</dt>
                          <dd class="rte">{{ block.settings.care }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.photo_conditions != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.photo_conditions' | t }}</dt>
                          <dd>{{ block.settings.photo_conditions | escape }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if block.settings.sale_type != blank -%}
                        <div class="private-archive__row">
                          <dt>{{ 'private_archive.labels.sale_type' | t }}</dt>
                          <dd>{{ block.settings.sale_type | escape }}</dd>
                        </div>
                      {%- endif -%}
                    </dl>

                    {%- if block.settings.shipping != blank -%}
                      <div class="private-archive__documentation-note">
                        <p>{{ 'private_archive.labels.shipping' | t }}</p>
                        <div class="rte">{{ block.settings.shipping }}</div>
                      </div>
                    {%- endif -%}
                  </div>
                </details>
              {%- endif -%}

              {%- if block.settings.notes != blank -%}
                <div class="private-archive__notes rte">{{ block.settings.notes }}</div>
              {%- endif -%}

              {%- if block.settings.link != blank -%}
                <a class="private-archive__link link" href="{{ block.settings.link }}" data-testid="private-archive-specimen-link">
                  {{- link_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="private-archive__published" data-testid="private-archive-published">
        {%- if section.settings.collection_heading != blank -%}
          <h2 class="private-archive__subheading">{{ section.settings.collection_heading | escape }}</h2>
        {%- endif -%}
        <div class="private-archive__grid">
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            <article class="private-archive__item private-archive__item--product">
              <a href="{{ product.url }}" class="private-archive__media" tabindex="-1" aria-hidden="true">
                {%- if product.featured_media != blank -%}
                  {{
                    product.featured_media
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      widths: '400, 600, 800, 1000, 1200, 1400',
                      class: 'private-archive__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'private-archive__image private-archive__image--placeholder' }}
                {%- endif -%}
              </a>
              <div class="private-archive__body">
                <h2 class="private-archive__name">
                  <a href="{{ product.url }}" class="private-archive__name-link">{{ product.title | escape }}</a>
                </h2>
                <a class="private-archive__link link" href="{{ product.url }}">{{ 'private_archive.view_specimen' | t }}</a>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.enable_filters -%}
  <script>
    (function () {
      var root = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!root) return;
      var filters = root.querySelectorAll('.private-archive__filter');
      var grid = root.querySelector('#ArchiveGrid-{{ section.id }}');
      if (!filters.length || !grid) return;
      var items = grid.querySelectorAll('.private-archive__item');
      root.classList.add('private-archive--filters-ready');
      filters.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var value = btn.getAttribute('data-filter');
          filters.forEach(function (b) {
            var active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          items.forEach(function (item) {
            var show = value === 'all' || item.getAttribute('data-status') === value;
            item.hidden = !show;
          });
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.private-archive.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.private-archive.settings.eyebrow.label",
      "info": "t:sections.private-archive.settings.eyebrow.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.private-archive.settings.heading.label",
      "info": "t:sections.private-archive.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.private-archive.settings.intro.label",
      "info": "t:sections.private-archive.settings.intro.info"
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "default": true,
      "label": "t:sections.private-archive.settings.enable_filters.label",
      "info": "t:sections.private-archive.settings.enable_filters.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.private-archive.settings.collection_header.content",
      "info": "t:sections.private-archive.settings.collection_header.info"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.private-archive.settings.collection.label",
      "info": "t:sections.private-archive.settings.collection.info"
    },
    {
      "type": "text",
      "id": "collection_heading",
      "label": "t:sections.private-archive.settings.collection_heading.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6,
      "label": "t:sections.private-archive.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "specimen",
      "name": "t:sections.private-archive.blocks.specimen.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.private-archive.blocks.specimen.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "image_secondary",
          "label": "t:sections.private-archive.blocks.specimen.settings.image_secondary.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.private-archive.blocks.specimen.settings.name.label"
        },
        {
          "type": "text",
          "id": "plant_id",
          "label": "t:sections.private-archive.blocks.specimen.settings.plant_id.label"
        },
        {
          "type": "text",
          "id": "genetics",
          "label": "t:sections.private-archive.blocks.specimen.settings.genetics.label"
        },
        {
          "type": "text",
          "id": "parentage",
          "label": "t:sections.private-archive.blocks.specimen.settings.parentage.label"
        },
        {
          "type": "text",
          "id": "breeder",
          "label": "t:sections.private-archive.blocks.specimen.settings.breeder.label"
        },
        {
          "type": "text",
          "id": "year",
          "label": "t:sections.private-archive.blocks.specimen.settings.year.label"
        },
        {
          "type": "text",
          "id": "primary_trait",
          "label": "t:sections.private-archive.blocks.specimen.settings.primary_trait.label"
        },
        {
          "type": "text",
          "id": "growth_stage",
          "label": "t:sections.private-archive.blocks.specimen.settings.growth_stage.label"
        },
        {
          "type": "text",
          "id": "propagation",
          "label": "t:sections.private-archive.blocks.specimen.settings.propagation.label"
        },
        {
          "type": "text",
          "id": "origin",
          "label": "t:sections.private-archive.blocks.specimen.settings.origin.label"
        },
        {
          "type": "text",
          "id": "rarity",
          "label": "t:sections.private-archive.blocks.specimen.settings.rarity.label"
        },
        {
          "type": "richtext",
          "id": "care",
          "label": "t:sections.private-archive.blocks.specimen.settings.care.label"
        },
        {
          "type": "text",
          "id": "photo_conditions",
          "label": "t:sections.private-archive.blocks.specimen.settings.photo_conditions.label"
        },
        {
          "type": "text",
          "id": "sale_type",
          "label": "t:sections.private-archive.blocks.specimen.settings.sale_type.label"
        },
        {
          "type": "richtext",
          "id": "shipping",
          "label": "t:sections.private-archive.blocks.specimen.settings.shipping.label"
        },
        {
          "type": "select",
          "id": "status",
          "label": "t:sections.private-archive.blocks.specimen.settings.status.label",
          "default": "private_collection",
          "options": [
            {
              "value": "private_collection",
              "label": "t:sections.private-archive.blocks.specimen.settings.status.options__1.label"
            },
            {
              "value": "archived",
              "label": "t:sections.private-archive.blocks.specimen.settings.status.options__2.label"
            },
            {
              "value": "past_release",
              "label": "t:sections.private-archive.blocks.specimen.settings.status.options__3.label"
            },
            {
              "value": "sold",
              "label": "t:sections.private-archive.blocks.specimen.settings.status.options__4.label"
            },
            {
              "value": "breeding_stock",
              "label": "t:sections.private-archive.blocks.specimen.settings.status.options__5.label"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "notes",
          "label": "t:sections.private-archive.blocks.specimen.settings.notes.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.private-archive.blocks.specimen.settings.link.label",
          "info": "t:sections.private-archive.blocks.specimen.settings.link.info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.private-archive.blocks.specimen.settings.link_label.label",
          "info": "t:sections.private-archive.blocks.specimen.settings.link_label.info"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "t:sections.private-archive.presets.name",
      "blocks": [
        {
          "type": "specimen"
        },
        {
          "type": "specimen"
        }
      ]
    }
  ]
}
{% endschema %}
