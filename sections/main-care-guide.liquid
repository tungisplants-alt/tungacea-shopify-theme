{% comment %}
  Tungacea — Pflegeguide.

  Eine Seite, die Tungs eigene Erfahrung beschreibt: Bedingungen, Pflege je
  Stadium, Nährstoffe, Gießwasser (pH und EC). Alle Inhalte stehen in Blöcken im
  Theme-Editor; die Vorlage muss dafür nicht angefasst werden. Leere Felder und
  leere Kapitel werden ausgeblendet, auch in der Kapitel-Leiste.

  Blöcke:
  - bedingung:  Zeile für Kapitel 1 (Name und Wert)
  - stadium:    Pflege eines Stadiums (aufklappbar), mit vier Kennzahlen:
                VPD in kPa, PPFD in µmol/m²/s, Temperatur in °C, EC in mS/cm.
                Die Einheiten setzt die Vorlage, es werden nur Zahlen getippt.
  - naehrstoff: Dünger oder Zusatz (Name, Art, Funktion, Grund, Dosierung),
                aufklappbar: zu Beginn nur der Name
  - punkt:      aufklappbarer Punkt unter Ankunft, Substrat oder Probleme
  - wasser:     Zeile der Tabelle pH und EC je Stadium

  Der Disclaimer steht fest oben unter dem Kopf. Ohne eigenen Text kommt er aus
  den Sprachdateien (care_guide.disclaimer), Deutsch und Englisch getrennt.

  Die Seite erreicht man über /pages/pflegeguide. Die Produktseite verlinkt nur,
  wenn es diese Seite gibt.
{% endcomment %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'component-care-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'care-guide.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign titel = section.settings.heading | default: '' | strip | escape
  if titel == blank
    assign titel = 'care_guide.heading' | t
  endif
  assign eyebrow = section.settings.eyebrow | default: '' | strip | escape
  if eyebrow == blank
    assign eyebrow = 'care_guide.eyebrow' | t
  endif
  assign lead = section.settings.lead | default: '' | strip | escape
  if lead == blank
    assign lead = 'care_guide.lead' | t
  endif
  assign disclaimer = section.settings.disclaimer | default: '' | strip | escape
  if disclaimer == blank
    assign disclaimer = 'care_guide.disclaimer' | t
  endif
  assign disclaimer_titel = 'care_guide.disclaimer_title' | t

  assign hat_bedingungen = false
  assign hat_stadien = false
  assign hat_naehrstoffe = false
  assign hat_wasser = false
  assign hat_ankunft = false
  assign hat_substrat = false
  assign hat_probleme = false
  comment
    Ein Kapitel erscheint erst, wenn mindestens eine Zeile ausgefuellt ist.
    Die Vorlage bringt leere Zeilen mit (Aufstellung, Substrat, Wasser je
    Stadium und so weiter), damit im Editor nur noch Werte einzutragen sind;
    leer duerfen sie keine Ueberschrift ohne Inhalt erzeugen.
  endcomment
  for block in section.blocks
    case block.type
      when 'bedingung'
        if block.settings.name != blank and block.settings.wert != blank
          assign hat_bedingungen = true
        endif
      when 'stadium'
        assign hat_stadien = true
      when 'naehrstoff'
        if block.settings.name != blank
          assign hat_naehrstoffe = true
        endif
      when 'wasser'
        if block.settings.ph != blank or block.settings.ec != blank
          assign hat_wasser = true
        endif
      when 'punkt'
        assign punkt_hat_inhalt = false
        if block.settings.text != blank or block.settings.erkennen != blank or block.settings.ursache != blank or block.settings.massnahme != blank
          assign punkt_hat_inhalt = true
        endif
        if block.settings.titel != blank and punkt_hat_inhalt
          case block.settings.thema
            when 'ankunft'
              assign hat_ankunft = true
            when 'substrat'
              assign hat_substrat = true
            when 'probleme'
              assign hat_probleme = true
          endcase
        endif
      when 'kapitel'
        if block.settings.text != blank
          case block.settings.thema
            when 'ankunft'
              assign hat_ankunft = true
            when 'substrat'
              assign hat_substrat = true
            when 'probleme'
              assign hat_probleme = true
          endcase
        endif
    endcase
  endfor
  assign ph_ziel = section.settings.ph_ziel | default: '' | strip
  assign ec_ziel = section.settings.ec_ziel | default: '' | strip
  if ph_ziel != blank or ec_ziel != blank
    assign hat_wasser = true
  endif

  assign kapitel_bedingungen = section.settings.bedingungen_titel | default: '' | strip | escape
  if kapitel_bedingungen == blank
    assign kapitel_bedingungen = 'care_guide.conditions_title' | t
  endif
  assign lead_bedingungen = section.settings.bedingungen_lead | default: '' | strip | escape
  if lead_bedingungen == blank
    assign lead_bedingungen = 'care_guide.conditions_lead' | t
  endif
  assign kapitel_stadien = section.settings.stadien_titel | default: '' | strip | escape
  if kapitel_stadien == blank
    assign kapitel_stadien = 'care_guide.picker_title' | t
  endif
  assign lead_stadien = section.settings.stadien_lead | default: '' | strip | escape
  if lead_stadien == blank
    assign lead_stadien = 'care_guide.stages_lead' | t
  endif
  assign kapitel_naehrstoffe = section.settings.naehrstoffe_titel | default: '' | strip | escape
  if kapitel_naehrstoffe == blank
    assign kapitel_naehrstoffe = 'care_guide.nutrients_title' | t
  endif
  assign lead_naehrstoffe = section.settings.naehrstoffe_lead | default: '' | strip | escape
  if lead_naehrstoffe == blank
    assign lead_naehrstoffe = 'care_guide.nutrients_lead' | t
  endif
  assign kapitel_wasser = section.settings.wasser_titel | default: '' | strip | escape
  if kapitel_wasser == blank
    assign kapitel_wasser = 'care_guide.water_title' | t
  endif
  assign lead_wasser = section.settings.wasser_lead | default: '' | strip | escape
  if lead_wasser == blank
    assign lead_wasser = 'care_guide.water_lead' | t
  endif

  assign bild_vorhanden = false
  if section.settings.bild != blank
    assign bild_vorhanden = true
  endif

  capture wa_link
    render 'whatsapp-option', css_laden: false, ohne_zusatz: true, klasse: 'care-guide__button'
  endcapture
-%}

<care-guide class="care-guide color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-testid="care-guide">
  {%- if bild_vorhanden -%}
    {%- capture bild_url -%}{{ section.settings.bild | image_url: width: 1600 }}{%- endcapture -%}
  {%- else -%}
    {%- capture bild_url -%}{{ 'tungacea-pflegeguide-kopf.jpg' | asset_url }}{%- endcapture -%}
  {%- endif -%}
  <div class="care-guide__hero" style="--guide-bild: url('{{ bild_url }}');">
    <div class="page-width">
      <header class="care-guide__intro">
        <p class="care-guide__eyebrow">{{ eyebrow }}</p>
        <h1 class="care-guide__heading">{{ titel }}</h1>
        <p class="care-guide__lead">{{ lead }}</p>
      </header>
    </div>
  </div>

  <div class="page-width">


    {%- if hat_stadien -%}
      {%- comment -%}
        Die Stadien als Herbar-Tafel: Zeichnung antippen, das Stadium steht
        direkt darunter. Ohne Skript sind alle Stadien als Kästen da.
      {%- endcomment -%}
      <section class="care-guide__chapter care-guide__chapter--stadien" id="stadien" data-testid="care-guide-stages">
        <h2 class="care-guide__title">{{ kapitel_stadien }}</h2>
        <p class="care-guide__chapter-lead">{{ lead_stadien }}</p>
        {%- render 'care-guide-tafel', bloecke: section.blocks -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'stadium' -%}
            {%- liquid
              assign s = block.settings.stadium
              assign s_label = ''
              case s
                when 'steckling'
                  assign s_label = 'products.product.specimen.stage_cutting' | t
                when 'etabliert'
                  assign s_label = 'products.product.specimen.stage_established' | t
                when 'jungpflanze'
                  assign s_label = 'products.product.specimen.stage_young' | t
                when 'saemling'
                  assign s_label = 'products.product.specimen.stage_seedling' | t
                when 'samen'
                  assign s_label = 'products.product.specimen.stage_seeds' | t
                when 'mutterpflanze'
                  assign s_label = 'products.product.specimen.stage_mother' | t
              endcase
              assign kurz = block.settings.kurz | default: '' | strip
              assign vpd = block.settings.vpd | default: '' | strip
              assign ppfd = block.settings.ppfd | default: '' | strip
              assign temperatur = block.settings.temperatur | default: '' | strip
              assign ec = block.settings.ec | default: '' | strip
              assign peek = ''
              if vpd != blank
                assign peek = 'care_guide.value_vpd' | t: wert: vpd
              endif
              if ppfd != blank
                if peek != blank
                  assign peek = peek | append: ' · '
                endif
                assign peek_teil = 'care_guide.value_ppfd' | t: wert: ppfd
                assign peek = peek | append: peek_teil
              endif
              if temperatur != blank
                if peek != blank
                  assign peek = peek | append: ' · '
                endif
                assign peek_teil = 'care_guide.value_temperature' | t: wert: temperatur
                assign peek = peek | append: peek_teil
              endif
              if ec != blank
                if peek != blank
                  assign peek = peek | append: ' · '
                endif
                assign peek_teil = 'care_guide.value_ec' | t: wert: ec
                assign peek = peek | append: peek_teil
              endif
              assign z_aufstellung = block.settings.aufstellung | default: '' | strip
              assign z_giessen = block.settings.giessen | default: '' | strip
              assign z_umtopfen = block.settings.umtopfen | default: '' | strip
              assign z_naehrstoffe = block.settings.naehrstoffe | default: '' | strip
              assign z_sonst = block.settings.sonst | default: '' | strip
              assign z_fehler = block.settings.fehler | default: '' | strip
              assign z_tipp = block.settings.tipp | default: '' | strip
              assign hat_zeilen = false
              if z_aufstellung != blank or z_giessen != blank or z_umtopfen != blank or z_naehrstoffe != blank or z_sonst != blank or z_fehler != blank or z_tipp != blank
                assign hat_zeilen = true
              endif
              assign hat_inhalt = false
              if kurz != blank or vpd != blank or ppfd != blank or temperatur != blank or ec != blank or block.settings.text != blank or hat_zeilen
                assign hat_inhalt = true
              endif
            -%}
            <details class="care-guide__stage" id="stadium-{{ s }}" {{ block.shopify_attributes }}>
              <summary class="care-guide__stage-toggle">
                <span class="care-guide__stage-name">
                  <span class="care-guide__stage-title">{{ s_label | escape }}</span>
                  {%- if peek != blank -%}
                    <span class="care-guide__stage-peek">{{ peek | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="care-guide__indicator" aria-hidden="true"></span>
              </summary>
              <div class="care-guide__stage-body">
                {%- if hat_inhalt -%}
                  <div class="care-guide__karte">
                    {%- if kurz != blank -%}
                      <p class="care-guide__short">{{ kurz | escape }}</p>
                    {%- endif -%}
                    {%- if vpd != blank or ppfd != blank or temperatur != blank or ec != blank -%}
                      <dl class="care-guide__figures">
                        {%- if vpd != blank -%}
                          <div><dt>{{ 'care_guide.figure_humidity' | t }}</dt><dd>{{ 'care_guide.value_vpd' | t: wert: vpd | escape }}</dd></div>
                        {%- endif -%}
                        {%- if ppfd != blank -%}
                          <div><dt>{{ 'care_guide.figure_light' | t }}</dt><dd>{{ 'care_guide.value_ppfd' | t: wert: ppfd | escape }}</dd></div>
                        {%- endif -%}
                        {%- if temperatur != blank -%}
                          <div><dt>{{ 'care_guide.figure_temperature' | t }}</dt><dd>{{ 'care_guide.value_temperature' | t: wert: temperatur | escape }}</dd></div>
                        {%- endif -%}
                        {%- if ec != blank -%}
                          <div><dt>{{ 'care_guide.figure_fertilizer' | t }}</dt><dd>{{ 'care_guide.value_ec' | t: wert: ec | escape }}</dd></div>
                        {%- endif -%}
                      </dl>
                    {%- endif -%}
                    {%- if hat_zeilen -%}
                      {%- liquid
                        assign l_setup = 'care_guide.row_setup' | t
                        assign l_water = 'care_guide.row_water' | t
                        assign l_repot = 'care_guide.row_repot' | t
                        assign l_feed = 'care_guide.row_feed' | t
                        assign l_more = 'care_guide.row_more' | t
                        assign l_mistake = 'care_guide.row_mistake' | t
                        assign l_tip = 'care_guide.row_tip' | t
                      -%}
                      {%- render 'care-guide-zeile', label: l_setup, text: z_aufstellung -%}
                      {%- render 'care-guide-zeile', label: l_water, text: z_giessen -%}
                      {%- render 'care-guide-zeile', label: l_repot, text: z_umtopfen -%}
                      {%- render 'care-guide-zeile', label: l_feed, text: z_naehrstoffe -%}
                      {%- render 'care-guide-zeile', label: l_more, text: z_sonst -%}
                      {%- render 'care-guide-zeile', label: l_mistake, text: z_fehler, art: 'fehler' -%}
                      {%- render 'care-guide-zeile', label: l_tip, text: z_tipp, art: 'tipp' -%}
                    {%- elsif block.settings.text != blank -%}
                      <div class="care-guide__text care-guide__zeile rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <p class="care-guide__empty">{{ 'care_guide.empty' | t }}</p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
        {%- render 'care-guide-begriffe' -%}
      </section>
    {%- endif -%}

    {%- comment -%}
      Die übrigen Kapitel als kleine Tafel im System der Stadien, unter den
      Stadien, damit oben zuerst die Frage nach dem Stadium kommt.
    {%- endcomment -%}
    {%- render 'care-guide-kapitel',
      ankunft: hat_ankunft,
      bedingungen: hat_bedingungen,
      substrat: hat_substrat,
      naehrstoffe: hat_naehrstoffe,
      wasser: hat_wasser,
      probleme: hat_probleme
    -%}

    {%- comment -%}
      Die Kapitel stehen in der Reihenfolge der Tafel: Ankunft, Bedingungen,
      Substrat, Nährstoffe, Gießwasser, Probleme.
    {%- endcomment -%}
    {%- render 'care-guide-freies-kapitel', bloecke: section.blocks, thema: 'ankunft' -%}

    {%- if hat_bedingungen -%}
      <section class="care-guide__chapter" id="bedingungen" data-testid="care-guide-conditions">
        <h2 class="care-guide__title">{{ kapitel_bedingungen }}</h2>
        <p class="care-guide__chapter-lead">{{ lead_bedingungen }}</p>
        <dl class="care-guide__facts">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bedingung' -%}
              {%- assign wert = block.settings.wert | default: '' | strip -%}
              {%- if block.settings.name != blank and wert != blank -%}
                <div class="care-guide__fact" {{ block.shopify_attributes }}>
                  <dt>{{ block.settings.name | escape }}</dt>
                  <dd>{{ wert | escape }}</dd>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </dl>
      </section>
    {%- endif -%}

    {%- render 'care-guide-freies-kapitel', bloecke: section.blocks, thema: 'substrat' -%}

    {%- if hat_naehrstoffe -%}
      <section class="care-guide__chapter" id="naehrstoffe" data-testid="care-guide-nutrients">
        <h2 class="care-guide__title">{{ kapitel_naehrstoffe }}</h2>
        <p class="care-guide__chapter-lead">{{ lead_naehrstoffe }}</p>
        {%- liquid
          assign hat_basis = false
          assign hat_zusatz = false
          for block in section.blocks
            if block.type == 'naehrstoff' and block.settings.name != blank
              if block.settings.art == 'zusatz'
                assign hat_zusatz = true
              else
                assign hat_basis = true
              endif
            endif
          endfor
          assign gruppen_naehr = 'basis,zusatz' | split: ','
        -%}
        {%- for gruppe in gruppen_naehr -%}
          {%- assign gruppe_da = false -%}
          {%- if gruppe == 'basis' and hat_basis -%}{%- assign gruppe_da = true -%}{%- endif -%}
          {%- if gruppe == 'zusatz' and hat_zusatz -%}{%- assign gruppe_da = true -%}{%- endif -%}
          {%- if gruppe_da -%}
            {%- if hat_basis and hat_zusatz -%}
              <h3 class="care-guide__gruppe">
                {%- if gruppe == 'basis' -%}{{ 'care_guide.group_basis' | t }}{%- else -%}{{ 'care_guide.group_addition' | t }}{%- endif -%}
              </h3>
            {%- endif -%}
            <ul class="care-guide__klappen" role="list">
              {%- for block in section.blocks -%}
                {%- assign block_gruppe = 'basis' -%}
                {%- if block.settings.art == 'zusatz' -%}{%- assign block_gruppe = 'zusatz' -%}{%- endif -%}
                {%- if block.type == 'naehrstoff' and block.settings.name != blank and block_gruppe == gruppe -%}
                  <li {{ block.shopify_attributes }}>
                    {%- assign wann = block.settings.wann | default: '' | strip -%}
                    {%- if block.settings.zweck != blank or block.settings.grund != blank or block.settings.dosierung != blank -%}
                      <details class="care-guide__klappe">
                        <summary class="care-guide__klappe-kopf">
                          <span class="care-guide__klappe-name">
                            <span class="care-guide__klappe-titel">{{ block.settings.name | escape }}</span>
                            {%- if wann != blank -%}
                              <span class="care-guide__klappe-wann">{{ wann | escape }}</span>
                            {%- endif -%}
                          </span>
                          <span class="care-guide__klappe-zeichen" aria-hidden="true"></span>
                        </summary>
                        <div class="care-guide__klappe-inhalt care-guide__klappe-inhalt--zeilen">
                          {%- assign l_dose = 'care_guide.label_dose' | t -%}
                          {%- assign l_funktion = 'care_guide.label_function' | t -%}
                          {%- assign l_grund = 'care_guide.label_reason' | t -%}
                          {%- render 'care-guide-zeile', label: l_dose, text: block.settings.dosierung, art: 'tipp' -%}
                          {%- render 'care-guide-zeile', label: l_funktion, text: block.settings.zweck -%}
                          {%- render 'care-guide-zeile', label: l_grund, text: block.settings.grund -%}
                        </div>
                      </details>
                    {%- else -%}
                      <div class="care-guide__klappe care-guide__klappe--einfach">
                        <span class="care-guide__klappe-titel">{{ block.settings.name | escape }}</span>
                      </div>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endfor -%}
      </section>
    {%- endif -%}

    {%- if hat_wasser -%}
      <section class="care-guide__chapter" id="wasser" data-testid="care-guide-water">
        <h2 class="care-guide__title">{{ kapitel_wasser }}</h2>
        <p class="care-guide__chapter-lead">{{ lead_wasser }}</p>
        {%- if ph_ziel != blank or ec_ziel != blank -%}
          <div class="care-guide__tiles">
            {%- if ph_ziel != blank -%}
              <div class="care-guide__tile"><small>pH</small><b>{{ ph_ziel | escape }}</b><span>{{ 'care_guide.water_target' | t }}</span></div>
            {%- endif -%}
            {%- if ec_ziel != blank -%}
              <div class="care-guide__tile"><small>EC</small><b>{{ ec_ziel | escape }}</b><span>{{ 'care_guide.water_unit' | t }}</span></div>
            {%- endif -%}
          </div>
        {%- endif -%}
        <dl class="care-guide__facts">
          {%- for block in section.blocks -%}
            {%- if block.type == 'wasser' -%}
              {%- liquid
                assign w_label = ''
                case block.settings.stadium
                  when 'steckling'
                    assign w_label = 'products.product.specimen.stage_cutting' | t
                  when 'etabliert'
                    assign w_label = 'products.product.specimen.stage_established' | t
                  when 'jungpflanze'
                    assign w_label = 'products.product.specimen.stage_young' | t
                  when 'saemling'
                    assign w_label = 'products.product.specimen.stage_seedling' | t
                  when 'samen'
                    assign w_label = 'products.product.specimen.stage_seeds' | t
                  when 'mutterpflanze'
                    assign w_label = 'products.product.specimen.stage_mother' | t
                endcase
                assign w_ph = block.settings.ph | default: '' | strip
                assign w_ec = block.settings.ec | default: '' | strip
                assign w_wert = ''
                if w_ph != blank
                  assign w_wert = 'pH ' | append: w_ph
                endif
                if w_ec != blank
                  if w_wert != blank
                    assign w_wert = w_wert | append: ' · '
                  endif
                  assign w_wert = w_wert | append: 'EC ' | append: w_ec
                endif
              -%}
              {%- if w_wert != blank -%}
                <div class="care-guide__fact" {{ block.shopify_attributes }}>
                  <dt>{{ w_label | escape }}</dt>
                  <dd>{{ w_wert | escape }}</dd>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </dl>
      </section>
    {%- endif -%}

    {%- render 'care-guide-freies-kapitel', bloecke: section.blocks, thema: 'probleme' -%}

    {%- comment -%}
      Der Disclaimer steht am Ende: erst die Pflege, dann der Hinweis, dass es
      Tungs eigene Erfahrungswerte sind.
    {%- endcomment -%}
    {%- assign stand = section.settings.stand | default: '' | strip | escape -%}
    {%- if stand != blank -%}
      <p class="care-guide__stand" data-testid="care-guide-stand">{{ 'care_guide.stand_label' | t }}: {{ stand }}</p>
    {%- endif -%}

    <aside class="care-guide__disclaimer" role="note" data-testid="care-guide-disclaimer">
      <strong>{{ disclaimer_titel }}</strong>
      <p>{{ disclaimer }}</p>
    </aside>

    {%- if wa_link != blank -%}
      <section class="care-guide__questions" id="fragen" data-testid="care-guide-questions">
        <p class="care-guide__eyebrow">{{ 'care_guide.questions_title' | t }}</p>
        <p>{{ 'care_guide.questions_text' | t }}</p>
        {{ wa_link }}
      </section>
    {%- endif -%}
  </div>
</care-guide>

{% schema %}
{
  "name": "Pflegeguide",
  "tag": "section",
  "class": "section",
  "max_blocks": 60,
  "settings": [
    { "type": "header", "content": "Kopf" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "info": "Leer lassen: Dann wird übersetzt." },
    { "type": "text", "id": "heading", "label": "Überschrift", "info": "Leer lassen: Dann wird übersetzt." },
    { "type": "textarea", "id": "lead", "label": "Einleitung", "info": "Leer lassen: Dann wird übersetzt." },
    { "type": "image_picker", "id": "bild", "label": "Foto im Kopf", "info": "Leer lassen: Das Blatt mit den roten Adern. Es wird abgedunkelt." },
    { "type": "header", "content": "Stand (am Ende der Seite)" },
    { "type": "text", "id": "stand", "label": "Stand", "info": "Zum Beispiel 11/2026. Die Zahl gilt in beiden Sprachen gleich. Leer lassen: Die Zeile fehlt." },
    { "type": "header", "content": "Disclaimer (am Ende der Seite)" },
    { "type": "textarea", "id": "disclaimer", "label": "Text", "info": "Leer lassen: Dann wird übersetzt. Ein eigener Text erscheint in beiden Sprachen gleich." },
    { "type": "header", "content": "Kapitel 1: Bedingungen" },
