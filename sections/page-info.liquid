{% comment %}
  Tungacea — zwei Karten unter einer Seite: "Auf einen Blick" (Zeilen mit
  Name und Wert) und "Weiter" (Zeilen als Links). Dasselbe System wie die
  Karten auf Produktseite, Archiv und Pflegeguide: kleine Kopfzeile in
  Großbuchstaben, fast schwarze Karte, Reihen mit eingerückten Haarlinien.

  Blöcke:
  - fakt: Name und Wert. Die Karte erscheint, sobald es eine Zeile mit Wert gibt.
          Mit "Live" kommt der Wert aus dem Shop und stimmt immer:
          verfuegbar = Zahl der Pflanzen, die gerade zu kaufen sind,
          archiv = Zahl der Pflanzen im Archiv. Mit Link wird die Zeile zum Weg
          dorthin (Pfeil rechts).
  - link: Titel, Link und optional eine kleine Zeile darunter. Die Karte erscheint,
          sobald es einen Link mit Titel gibt.

  Leere Überschriften werden übersetzt (page_info.*); ein eigener Text im
  Theme-Editor erscheint in beiden Sprachen gleich.
{% endcomment %}
{{ 'component-page-info.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign hat_fakten = false
  assign hat_links = false
  assign braucht_verfuegbar = false
  assign braucht_archiv = false
  for block in section.blocks
    if block.type == 'fakt' and block.settings.live == 'verfuegbar'
      assign braucht_verfuegbar = true
    endif
    if block.type == 'fakt' and block.settings.live == 'archiv'
      assign braucht_archiv = true
    endif
  endfor
  assign anzahl_verfuegbar = 0
  assign anzahl_archiv = 0
  if braucht_archiv
    assign anzahl_archiv = shop.metaobjects.mutterpflanze.values.size
  endif
-%}
{%- comment -%}
  Die Zaehlung der kaufbaren Pflanzen laeuft in dieser Datei mit paginate: Shopify
  liefert sonst nur 50 Produkte (gemessen, siehe sections/main-plant-archive.liquid).
{%- endcomment -%}
{%- if braucht_verfuegbar -%}
  {%- paginate collections.all.products by 250 -%}
    {%- for produkt in collections.all.products -%}
      {%- if produkt.available -%}
        {%- assign anzahl_verfuegbar = anzahl_verfuegbar | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endpaginate -%}
{%- endif -%}
{%- liquid
  for block in section.blocks
    assign hat_wert = false
    if block.type == 'fakt' and block.settings.name != blank
      if block.settings.live == 'verfuegbar' or block.settings.live == 'archiv'
        assign hat_wert = true
      elsif block.settings.wert != blank
        assign hat_wert = true
      endif
    endif
    if hat_wert
      assign hat_fakten = true
    endif
    if block.type == 'link' and block.settings.titel != blank and block.settings.link != blank
      assign hat_links = true
    endif
  endfor

  assign titel_fakten = section.settings.fakten_titel | default: '' | strip | escape
  if titel_fakten == blank
    assign titel_fakten = 'page_info.glance_title' | t
  endif
  assign titel_weiter = section.settings.weiter_titel | default: '' | strip | escape
  if titel_weiter == blank
    assign titel_weiter = 'page_info.next_title' | t
  endif
-%}
{%- if hat_fakten or hat_links -%}
  <div class="page-info color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-testid="page-info">
    <div class="page-width">
      <div class="page-info__inner">
        {%- if hat_fakten -%}
          <section class="page-info__abschnitt" data-testid="page-info-facts">
            <h2 class="page-info__kopf">{{ titel_fakten }}</h2>
            <dl class="page-info__karte">
              {%- for block in section.blocks -%}
                {%- if block.type == 'fakt' and block.settings.name != blank -%}
                  {%- liquid
                    assign zeilen_wert = block.settings.wert | default: '' | strip
                    case block.settings.live
                      when 'verfuegbar'
                        if anzahl_verfuegbar == 0
                          assign zeilen_wert = 'page_info.available_zero' | t
                        elsif anzahl_verfuegbar == 1
                          assign zeilen_wert = 'page_info.available_one' | t
                        else
                          assign zeilen_wert = 'page_info.available_other' | t: anzahl: anzahl_verfuegbar
                        endif
                      when 'archiv'
                        if anzahl_archiv == 0
                          assign zeilen_wert = 'page_info.archive_zero' | t
                        elsif anzahl_archiv == 1
                          assign zeilen_wert = 'page_info.archive_one' | t
                        else
                          assign zeilen_wert = 'page_info.archive_other' | t: anzahl: anzahl_archiv
                        endif
                    endcase
                  -%}
                  {%- if zeilen_wert != blank -%}
                    {%- if block.settings.link != blank -%}
                      <div class="page-info__zeile page-info__zeile--fakt-link" {{ block.shopify_attributes }}>
                        <dt>{{ block.settings.name | escape }}</dt>
                        <dd>
                          <a class="page-info__fakt-link" href="{{ block.settings.link }}">
                            <span>{{ zeilen_wert | escape }}</span>
                            <span class="page-info__pfeil" aria-hidden="true"></span>
                          </a>
                        </dd>
                      </div>
                    {%- else -%}
                      <div class="page-info__zeile" {{ block.shopify_attributes }}>
                        <dt>{{ block.settings.name | escape }}</dt>
                        <dd>{{ zeilen_wert | escape }}</dd>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </dl>
          </section>
        {%- endif -%}
        {%- if hat_links -%}
          <section class="page-info__abschnitt" data-testid="page-info-links">
            <h2 class="page-info__kopf">{{ titel_weiter }}</h2>
            <ul class="page-info__karte page-info__karte--links" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'link' and block.settings.titel != blank and block.settings.link != blank -%}
                  <li {{ block.shopify_attributes }}>
                    <a class="page-info__zeile page-info__zeile--link" href="{{ block.settings.link }}">
                      <span class="page-info__text">
                        <span class="page-info__titel">{{ block.settings.titel | escape }}</span>
                        {%- if block.settings.beschreibung != blank -%}
                          <span class="page-info__beschreibung">{{ block.settings.beschreibung | escape }}</span>
                        {%- endif -%}
                      </span>
                      <span class="page-info__pfeil" aria-hidden="true"></span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Karten Fakten und Links",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "fakten_titel", "label": "Überschrift Fakten", "info": "Leer lassen: Dann wird übersetzt (Auf einen Blick)." },
    { "type": "text", "id": "weiter_titel", "label": "Überschrift Links", "info": "Leer lassen: Dann wird übersetzt (Weiter)." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 64 }
  ],
  "blocks": [
    {
      "type": "fakt",
      "name": "Fakt",
      "settings": [
        { "type": "paragraph", "content": "Eine Zeile in der Karte „Auf einen Blick“. Ohne Wert erscheint sie nicht." },
        { "type": "text", "id": "name", "label": "Name", "info": "Zum Beispiel: Seit" },
        { "type": "text", "id": "wert", "label": "Wert", "info": "Zum Beispiel: 2024. Bei „Live“ unten leer lassen." },
        {
          "type": "select",
          "id": "live",
          "label": "Live",
          "info": "Der Wert kommt aus dem Shop und stimmt immer. Ersetzt das Feld Wert.",
          "options": [
            { "value": "keine", "label": "Nein, mein Wert" },
            { "value": "verfuegbar", "label": "Pflanzen, die gerade zu kaufen sind" },
            { "value": "archiv", "label": "Pflanzen im Archiv" }
          ],
          "default": "keine"
        },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Macht die Zeile zum Weg mit Pfeil." }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "paragraph", "content": "Eine Zeile in der Karte „Weiter“. Ohne Link erscheint sie nicht." },
        { "type": "text", "id": "titel", "label": "Titel" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "beschreibung", "label": "Zeile darunter", "info": "Optional, klein unter dem Titel." }
      ]
    }
  ],
  "presets": [
    { "name": "Karten Fakten und Links" }
  ]
}
{% endschema %}
