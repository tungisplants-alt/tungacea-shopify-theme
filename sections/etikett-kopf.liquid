{% comment %}
  Tungacea — Kopf der Etikett-Seite (Zusatzprodukt "Archiv-Etikett").

  Kleine Zeile, Überschrift, ein Satz und ein echtes Foto des Etiketts. Das
  Foto ist der wichtigste Teil: Es zeigt, was man kauft. Ohne eigenes Bild im
  Theme-Editor steht das mitgelieferte Foto (assets/etikett-foto.jpg).

  Leere Felder werden übersetzt (etikett_kopf.*). Ein eigener Text im
  Theme-Editor erscheint in beiden Sprachen gleich. Der Kopf setzt keine
  Überschrift der ersten Ebene: Die steht mit dem Produktnamen weiter unten.
{% endcomment %}
{{ 'section-etikett-kopf.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '' | strip | escape
  if eyebrow == blank
    assign eyebrow = 'etikett_kopf.eyebrow' | t
  endif
  assign heading = section.settings.heading | default: '' | strip | escape
  if heading == blank
    assign heading = 'etikett_kopf.heading' | t
  endif
  assign lead = section.settings.lead | default: '' | strip | escape
  if lead == blank
    assign lead = 'etikett_kopf.lead' | t
  endif
  assign bild_alt = section.settings.bild.alt | default: '' | strip
  if bild_alt == blank
    assign bild_alt = 'etikett_kopf.image_alt' | t
  endif
-%}
<div class="etikett-kopf color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-testid="etikett-kopf">
  <div class="page-width">
    <div class="etikett-kopf__raster">
      <header class="etikett-kopf__text">
        <p class="etikett-kopf__eyebrow">{{ eyebrow }}</p>
        <h2 class="etikett-kopf__heading">{{ heading }}</h2>
        <p class="etikett-kopf__lead">{{ lead }}</p>
        <a class="etikett-kopf__knopf" href="#etikett-konfigurator">{{ 'etikett_kopf.cta' | t }}</a>
        <dl class="etikett-kopf__fakten">
          {%- for k in (1..4) -%}
            {%- liquid
              assign l_key = 'etikett_kopf.fact_' | append: k | append: '_label'
              assign v_key = 'etikett_kopf.fact_' | append: k | append: '_value'
            -%}
            <div class="etikett-kopf__fakt">
              <dt>{{ l_key | t }}</dt>
              <dd>{{ v_key | t }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      </header>
      <figure class="etikett-kopf__foto">
        {%- if section.settings.bild != blank -%}
          {{
            section.settings.bild
            | image_url: width: 1100
            | image_tag: widths: '450, 700, 900, 1100', sizes: '(min-width: 750px) 40vw, 92vw', alt: bild_alt, loading: 'eager'
          }}
        {%- else -%}
          <img
            src="{{ 'etikett-foto.jpg' | asset_url }}"
            width="900"
            height="1125"
            alt="{{ bild_alt | escape }}"
            loading="eager"
          >
        {%- endif -%}
        <figcaption class="etikett-kopf__bildtext">{{ 'etikett_kopf.caption' | t }}</figcaption>
      </figure>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Etikett-Kopf",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "info": "Leer lassen: Dann wird übersetzt." },
    { "type": "textarea", "id": "heading", "label": "Überschrift", "info": "Leer lassen: Dann wird übersetzt." },
    { "type": "textarea", "id": "lead", "label": "Satz darunter", "info": "Leer lassen: Dann wird übersetzt." },
    { "type": "image_picker", "id": "bild", "label": "Foto", "info": "Leer lassen: Das mitgelieferte Foto vom Etikett." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 8 }
  ],
  "presets": [{ "name": "Etikett-Kopf" }]
}
{% endschema %}
