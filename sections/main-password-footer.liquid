{% assign scheme1 = settings.color_schemes | first %}
{%- if section.settings.color_scheme == scheme1 -%}<hr>{%- endif -%}
<div class="password__footer color-{{ section.settings.color_scheme }} gradient">
  {%- comment -%}
    Tungacea branded closing strip:
      1. Rakkan seal (reuses the shared snippet + asset, larger than the storefront seal)
      2. Compact native Shopify language selector (only when >1 published language)
      3. Dynamic-year copyright
    Store-owner admin link is kept (access functionality), rendered very quietly.
  {%- endcomment -%}
  <div class="password__footer-inner page-width">
    {%- render 'rakkan-seal', class: 'password-footer__seal', width_override: 72 -%}

    {%- if localization.available_languages.size > 1 -%}
      {%- comment -%}
        Native Shopify language switch: pure HTML, no JavaScript and no custom
        element. Each option links directly to the localized language root URL.
      {%- endcomment -%}
      <details class="password__footer-lang tungacea-lang">
        <summary class="tungacea-lang__button password__footer-lang__trigger" aria-label="{{ 'localization.language_label' | t }}">
          <span class="tungacea-lang__label">{{ 'localization.language_label' | t }}</span>
          <span class="tungacea-lang__current">{{ localization.language.endonym_name | capitalize }}</span>
          <span class="tungacea-lang__caret svg-wrapper" aria-hidden="true">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="tungacea-lang__panel password__footer-lang__panel">
          <ul class="tungacea-lang__list list-unstyled" role="list">
            {%- for language in localization.available_languages -%}
              <li class="tungacea-lang__item">
                <a
                  href="{{ language.root_url }}"
                  lang="{{ language.iso_code }}"
                  hreflang="{{ language.iso_code }}"
                  class="tungacea-lang__link password__footer-lang__submit"
                  data-testid="password-language-{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                >
                  <span class="tungacea-lang__name">{{ language.endonym_name | capitalize }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </details>
    {%- endif -%}

    <small class="password__footer-copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
    </small>

    <small class="password__footer-login password__footer-text">
      {{- 'general.password_page.admin_link_html' | t -}}
    </small>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-password-footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
